{
  "name": "@hollis/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:prepare-e2e": "node scripts/prepare-e2e.mjs",
    "db:prepare-test": "node scripts/prepare-integration-db.mjs",
    "test": "node --test scripts/e2e-database-safety.test.mjs",
    "test:integration": "vitest run test/tenant-isolation.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
