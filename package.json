{
  "name": "hollis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "cloud:preflight": "node scripts/cloud-run-preflight.mjs",
    "db:migrate": "dotenv -e .env -- pnpm --filter @hollis/database db:migrate",
    "dev": "dotenv -e .env -- pnpm --parallel --filter @hollis/api --filter @hollis/web dev",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "genlayer:check-studio": "node scripts/check-genlayer-studio-dev.mjs",
    "lint": "biome lint .",
    "policy": "node scripts/repository-policy.mjs repository",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "verify": "pnpm policy && pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "dotenv-cli": "11.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
