NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CLAIMS_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AUDIT_CHECKPOINT_KEY_ID=
AUDIT_CHECKPOINT_PRIVATE_KEY_BASE64=
AUDIT_CHECKPOINT_PUBLIC_KEY_BASE64=
# Optional legacy provider settings. Leave blank when using Cloudflare R2.
GCS_PROJECT_ID=
GCS_SIGNER_SERVICE_ACCOUNT=
GENLAYER_STUDIO_CONTRACT_ADDRESS=
GENLAYER_NETWORK=
GENLAYER_RPC_URL=
GENLAYER_CHAIN_ID=
GENLAYER_RUNTIME_ADDRESS=
GENLAYER_RUNTIME_PRIVATE_KEY=
PUBLIC_ATTESTATION_ORIGIN=
GCS_BUCKET=
AWS_REGION=
S3_BUCKET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_JURISDICTION=default
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RETENTION_TENANT_IDS=
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://hollis_app:hollis_app@localhost:5434/hollis
# Cloud Run alternative to DATABASE_URL. Set all four values only when using the Cloud SQL Unix socket.
DB_NAME=
DB_PASS=
DB_USER=
INSTANCE_UNIX_SOCKET=
DATABASE_MIGRATION_URL=postgres://hollis:hollis@localhost:5434/hollis
DATABASE_TEST_URL=postgres://hollis:hollis@localhost:5434/hollis_e2e
NEXT_PUBLIC_API_URL=http://localhost:4000
IDENTITY_PLATFORM_PROJECT_ID=hollis-507001
HOLLIS_SESSION_TTL_HOURS=8
RESEND_API_KEY=
