{
  "name": "@hollis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @hollis/contracts build && pnpm --filter @hollis/database build && tsc -p tsconfig.build.json && node scripts/prepare-vercel-workspace-packages.mjs",
    "dev": "tsx watch src/server.ts",
    "retention:run": "tsx src/retention-scheduler.ts",
    "audit-checkpoints:run": "tsx src/audit-checkpoint-scheduler.ts",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "test:integration": "vitest run test/persistence.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@aws-sdk/s3-request-presigner": "3.1129.0",
    "@azure/identity": "4.13.0",
    "@azure/storage-blob": "12.29.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@google-cloud/storage": "8.1.0",
    "@hollis/contracts": "workspace:*",
    "@hollis/database": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "genlayer-js": "2.0.0-rc.1",
    "google-auth-library": "9.15.1",
    "jose": "6.2.10",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
